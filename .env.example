# SevaHealth AI Environment Configuration
# Copy this file to .env before starting the platform

# Core Application Settings
ENVIRONMENT=development
APP_NAME=SevaHealth AI
APP_VERSION=0.1.0
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & IAM (adapted from bezs-iam)
SECRET_KEY=sevahealth-insecure-dev-secret-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL / SQLite Dual-Mode)
# For local zero-dependency testing, leave blank or set to sqlite:///./sevahealth.db
DATABASE_URL=sqlite:///./sevahealth.db
# For Docker Compose / Production:
# DATABASE_URL=postgresql+psycopg://seva:seva_password@postgres:5432/sevahealth_db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Object Storage / MinIO (adapted from bezs-filenest)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sevahealth-medical-vault
S3_USE_SSL=false

# AI Agent Provider Settings (adapted from refactoragent)
# Options: MOCK (default for offline evaluation), GEMINI, OPENAI
AI_PROVIDER=MOCK
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro

# OpenEHR & EHRbase Longitudinal Clinical Repository
EHRBASE_URL=http://localhost:8080/ehrbase/rest/openehr/v1
EHRBASE_USER=ehrbase-user
EHRBASE_PASSWORD=SuperSecretPassword
CLINICAL_REPOSITORY_BACKEND=hybrid

# Observability & Telemetry (adapted from bezs-observability)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

